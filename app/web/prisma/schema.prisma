generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  OPERATOR
  ENTREPRENEUR
  SUPPORT
}

enum EntrepreneurStatus {
  INVITED
  ACTIVE
  PAUSED
  ARCHIVED
}

enum WebAssetPackageType {
  PRODUCT_SALES
  VSL_RECRUITMENT
  FULL_COMBO
}

enum WebAssetPackageStatus {
  DRAFT
  SELECTED
  DATA_REQUIRED
  READY_FOR_ASSET
  ACTIVE
  PAUSED
  ARCHIVED
}

enum MasterAssetType {
  LANDING_TEMPLATE
  VSL_TEMPLATE
  COPY_BLOCK
  CREATIVE
  PRODUCT_REFERENCE
  EDUCATION_SEQUENCE
}

enum MasterAssetStatus {
  DRAFT
  VALIDATED
  DEPRECATED
  ARCHIVED
}

enum PersonalizedChannelType {
  PRODUCT_PAGE
  VSL_PAGE
  COMBO_PAGE
  CAMPAIGN_PAGE
}

enum PersonalizedChannelStatus {
  REQUESTED
  DRAFT
  READY_FOR_REVIEW
  PUBLISHED
  NEEDS_UPDATE
  PAUSED
  ARCHIVED
}

enum LeadDestinationType {
  WHATSAPP
  EXTERNAL_CHECKOUT
  EXTERNAL_FORM
  BOOKING_LINK
  SOCIAL_DM
  PHONE
  OTHER
}

enum LeadDestinationStatus {
  DRAFT
  ACTIVE
  PAUSED
  ARCHIVED
}

enum ValidatedMessageType {
  HERO_COPY
  CTA
  OBJECTION_RESPONSE
  PRODUCT_EDUCATION
  BUSINESS_EDUCATION
  COMPLIANCE_NOTE
  AD_COPY
}

enum ValidatedMessageStatus {
  DRAFT
  VALIDATED
  DEPRECATED
  ARCHIVED
}

enum TrafficCampaignStatus {
  REQUESTED
  READY
  ENABLED
  PAUSED
  COMPLETED
  CANCELLED
}

enum BusinessEventType {
  ENTREPRENEUR_CREATED
  ENTREPRENEUR_PACKAGE_SELECTED
  ENTREPRENEUR_DATA_SUBMITTED
  WEB_ASSET_REQUESTED
  PERSONALIZED_CHANNEL_CREATED
  PERSONALIZED_CHANNEL_PUBLISHED
  PERSONALIZED_CHANNEL_UPDATED_FROM_MASTER
  LEAD_DESTINATION_CREATED
  LEAD_DESTINATION_UPDATED
  MASTER_ASSET_CREATED
  MASTER_ASSET_UPDATED
  VALIDATED_MESSAGE_CREATED
  VALIDATED_MESSAGE_UPDATED
  TRAFFIC_CAMPAIGN_REQUESTED
  TRAFFIC_CAMPAIGN_ENABLED
  LEAD_REDIRECTED_TO_EXTERNAL_DESTINATION
}

model User {
  id             String        @id @default(cuid())
  name           String?
  email          String?       @unique
  image          String?
  role           UserRole      @default(OPERATOR)
  entrepreneurId String?
  entrepreneur   Entrepreneur? @relation(fields: [entrepreneurId], references: [id])
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
}

model Entrepreneur {
  id                   String                @id @default(cuid())
  displayName          String
  businessName         String?
  country              String?
  contactWhatsapp      String?
  status               EntrepreneurStatus    @default(INVITED)
  sourceContext        String?
  webAssetPackages     WebAssetPackage[]
  personalizedChannels PersonalizedChannel[]
  leadDestinations     LeadDestination[]
  trafficCampaigns     TrafficCampaign[]
  users                User[]
  businessEvents       BusinessEvent[]
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
}

model WebAssetPackage {
  id                   String                @id @default(cuid())
  entrepreneurId       String
  type                 WebAssetPackageType
  status               WebAssetPackageStatus @default(DRAFT)
  selectedAt           DateTime?
  requirements         Json                  @default("{}")
  entrepreneur         Entrepreneur          @relation(fields: [entrepreneurId], references: [id])
  personalizedChannels PersonalizedChannel[]
  trafficCampaigns     TrafficCampaign[]
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt

  @@index([entrepreneurId])
}

model MasterAsset {
  id                   String                @id @default(cuid())
  key                  String                @unique
  type                 MasterAssetType
  status               MasterAssetStatus     @default(DRAFT)
  title                String
  content              Json                  @default("{}")
  version              Int                   @default(1)
  validationNotes      String?
  personalizedChannels PersonalizedChannel[]
  validatedMessages    ValidatedMessage[]
  businessEvents       BusinessEvent[]
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
}

model PersonalizedChannel {
  id               String                    @id @default(cuid())
  entrepreneurId   String
  packageId        String?
  masterAssetId    String?
  type             PersonalizedChannelType
  status           PersonalizedChannelStatus @default(REQUESTED)
  title            String
  publicUrl        String?                   @unique
  rootDomain       String?
  subdomain        String?
  routePath        String?
  publishedAt      DateTime?
  configuration    Json                      @default("{}")
  entrepreneur     Entrepreneur              @relation(fields: [entrepreneurId], references: [id])
  package          WebAssetPackage?          @relation(fields: [packageId], references: [id])
  masterAsset      MasterAsset?              @relation(fields: [masterAssetId], references: [id])
  leadDestinations LeadDestination[]
  trafficCampaigns TrafficCampaign[]
  businessEvents   BusinessEvent[]
  createdAt        DateTime                  @default(now())
  updatedAt        DateTime                  @updatedAt

  @@index([entrepreneurId])
  @@index([packageId])
  @@index([masterAssetId])
}

model LeadDestination {
  id                    String                @id @default(cuid())
  entrepreneurId        String
  personalizedChannelId String?
  type                  LeadDestinationType
  status                LeadDestinationStatus @default(DRAFT)
  label                 String
  externalUrl           String?
  externalHandle        String?
  metadata              Json                  @default("{}")
  entrepreneur          Entrepreneur          @relation(fields: [entrepreneurId], references: [id])
  personalizedChannel   PersonalizedChannel?  @relation(fields: [personalizedChannelId], references: [id])
  businessEvents        BusinessEvent[]
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt

  @@index([entrepreneurId])
  @@index([personalizedChannelId])
}

model ValidatedMessage {
  id             String                 @id @default(cuid())
  masterAssetId  String?
  type           ValidatedMessageType
  status         ValidatedMessageStatus @default(DRAFT)
  title          String
  body           String
  locale         String                 @default("es-CO")
  validationNote String?
  masterAsset    MasterAsset?           @relation(fields: [masterAssetId], references: [id])
  businessEvents BusinessEvent[]
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt

  @@index([masterAssetId])
}

model TrafficCampaign {
  id                    String                @id @default(cuid())
  entrepreneurId        String
  packageId             String?
  personalizedChannelId String?
  status                TrafficCampaignStatus @default(REQUESTED)
  name                  String
  source                String?
  medium                String?
  budgetAmount          Decimal?              @db.Decimal(12, 2)
  budgetCurrency        String                @default("COP")
  configuration         Json                  @default("{}")
  enabledAt             DateTime?
  entrepreneur          Entrepreneur          @relation(fields: [entrepreneurId], references: [id])
  package               WebAssetPackage?      @relation(fields: [packageId], references: [id])
  personalizedChannel   PersonalizedChannel?  @relation(fields: [personalizedChannelId], references: [id])
  businessEvents        BusinessEvent[]
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt

  @@index([entrepreneurId])
  @@index([packageId])
  @@index([personalizedChannelId])
}

model BusinessEvent {
  id                    String               @id @default(cuid())
  type                  BusinessEventType
  occurredAt            DateTime             @default(now())
  actorType             String
  actorId               String?
  entrepreneurId        String?
  masterAssetId         String?
  personalizedChannelId String?
  leadDestinationId     String?
  validatedMessageId    String?
  trafficCampaignId     String?
  payload               Json                 @default("{}")
  entrepreneur          Entrepreneur?        @relation(fields: [entrepreneurId], references: [id])
  masterAsset           MasterAsset?         @relation(fields: [masterAssetId], references: [id])
  personalizedChannel   PersonalizedChannel? @relation(fields: [personalizedChannelId], references: [id])
  leadDestination       LeadDestination?     @relation(fields: [leadDestinationId], references: [id])
  validatedMessage      ValidatedMessage?    @relation(fields: [validatedMessageId], references: [id])
  trafficCampaign       TrafficCampaign?     @relation(fields: [trafficCampaignId], references: [id])
  createdAt             DateTime             @default(now())

  @@index([type])
  @@index([entrepreneurId])
  @@index([personalizedChannelId])
  @@index([leadDestinationId])
}
