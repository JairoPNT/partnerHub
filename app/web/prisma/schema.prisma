generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  PARTNER
  SUPPORT
}

enum PartnerStatus {
  ACTIVE
  PENDING
  SUSPENDED
}

enum PlanType {
  PRODUCT
  BUSINESS
  COMPLETE
  LEADER
}

enum SiteType {
  LANDING
  VSL
  COMPLETE
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum AssetType {
  IMAGE
  VIDEO
  COPY
  DOCUMENT
  TEMPLATE
}

enum CampaignStatus {
  DRAFT
  ACTIVE
  PAUSED
  COMPLETED
}

enum AutomationStatus {
  PENDING
  RUNNING
  SUCCESS
  FAILED
}

enum DomainStatus {
  PENDING
  ACTIVE
  EXPIRED
}

model User {
  id            String       @id @default(cuid())
  name          String?
  email         String?      @unique
  image         String?
  role          UserRole     @default(PARTNER)
  partner       Partner?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
}

model Partner {
  id            String        @id @default(cuid())
  code          String        @unique
  fullName      String
  email         String?       @unique
  phone         String?
  status        PartnerStatus @default(PENDING)
  userId        String?       @unique
  user          User?         @relation(fields: [userId], references: [id])
  planId        String?
  plan          Plan?         @relation(fields: [planId], references: [id])
  sites         Site[]
  payments      Payment[]
  domains       Domain[]
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
}

model Plan {
  id            String       @id @default(cuid())
  slug          String       @unique
  name          String
  type          PlanType
  description   String?
  setupPrice    Decimal      @db.Decimal(12, 2)
  monthlyPrice  Decimal      @db.Decimal(12, 2)
  features      Json         @default("[]")
  partners      Partner[]
  sites         Site[]
  payments      Payment[]
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
}

model Site {
  id            String      @id @default(cuid())
  partnerId     String
  planId        String?
  name          String
  slug          String      @unique
  type          SiteType
  subdomain     String?     @unique
  customDomain  String?     @unique
  isPublished   Boolean     @default(false)
  publishedAt   DateTime?
  partner       Partner     @relation(fields: [partnerId], references: [id])
  plan          Plan?       @relation(fields: [planId], references: [id])
  assets        CreativeAsset[]
  campaigns     Campaign[]
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
}

model Payment {
  id            String        @id @default(cuid())
  partnerId     String
  planId        String?
  amount        Decimal       @db.Decimal(12, 2)
  currency      String        @default("COP")
  status        PaymentStatus @default(PENDING)
  paidAt        DateTime?
  reference     String?       @unique
  metadata      Json          @default("{}")
  partner       Partner       @relation(fields: [partnerId], references: [id])
  plan          Plan?         @relation(fields: [planId], references: [id])
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
}

model MasterContent {
  id            String      @id @default(cuid())
  key           String      @unique
  title         String
  value         Json
  scope         String      @default("global")
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
}

model CreativeAsset {
  id            String      @id @default(cuid())
  siteId        String?
  type          AssetType
  title         String
  url           String
  tags          Json        @default("[]")
  metadata      Json        @default("{}")
  site          Site?       @relation(fields: [siteId], references: [id])
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
}

model Campaign {
  id            String         @id @default(cuid())
  siteId        String?
  title         String
  status        CampaignStatus @default(DRAFT)
  budget        Decimal?       @db.Decimal(12, 2)
  brief         Json           @default("{}")
  utmSource     String?
  utmMedium     String?
  utmCampaign   String?
  site          Site?          @relation(fields: [siteId], references: [id])
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
}

model AutomationRun {
  id            String           @id @default(cuid())
  name          String
  status        AutomationStatus @default(PENDING)
  trigger       String
  payload       Json             @default("{}")
  result        Json             @default("{}")
  startedAt     DateTime?
  finishedAt    DateTime?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
}

model Domain {
  id            String       @id @default(cuid())
  partnerId     String?
  host          String       @unique
  status        DomainStatus @default(PENDING)
  provider      String?
  dnsStatus     String?
  expiresAt     DateTime?
  partner       Partner?     @relation(fields: [partnerId], references: [id])
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
}

